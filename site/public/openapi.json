        "tags": [
          "providers"
        ]
      }
    },
    "/appointments": {
      "post": {
        "description": "Give a startsAt, or a window and time of day and let the API pick the first free time. The request stays pending until the provider confirms it. Concurrent requests never get the same time.",
        "operationId": "AppointmentsController_request",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestAppointmentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Outside working hours, off the 15-minute grid, too soon, or a bad window"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "That time is taken, or no free time in the window"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Request an appointment",
        "tags": [
          "appointments"
        ]
      }
    },
    "/appointments/me": {
      "get": {
        "description": "As a client, newest first.",
        "operationId": "AppointmentsController_mine",

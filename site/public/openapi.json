          "404": {
            "description": "Appointment not found"
          },
          "409": {
            "description": "Already over, or too late for the client to cancel"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cancel an appointment",
        "tags": [
          "appointments"
        ]
      }
    },

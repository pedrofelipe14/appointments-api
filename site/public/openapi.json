          "bookings"
        ]
      }
    },
    "/bookings/{id}/cancel": {
      "post": {
        "description": "Players need 24 hours of notice; the venue owner can always cancel.",
        "operationId": "BookingsController_cancel",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "404": {
            "description": "Booking not found"
          },
          "409": {
            "description": "Already cancelled/expired, or too close to start for a player to cancel"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cancel a booking",
        "tags": [
          "bookings"
        ]
      }
    },
    "/venues/{venueId}/bookings": {
      "get": {
        "description": "For the venue owner: the agenda of a local date.",
        "operationId": "BookingsController_forVenue",
        "parameters": [
          {
            "name": "venueId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "Local date at the venue (YYYY-MM-DD)",
            "schema": {
              "example": "2026-11-20",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All bookings at the venue on that local date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "403": {
            "description": "Requires role: owner or admin"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "A venue's bookings for a day",
        "tags": [
          "bookings"
        ]
      }
    },
    "/auth/register": {

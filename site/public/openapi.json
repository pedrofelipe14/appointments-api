              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "403": {
            "description": "Requires role: provider or admin"
          },
          "409": {
            "description": "You already have a provider profile"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create your provider profile",
        "tags": [

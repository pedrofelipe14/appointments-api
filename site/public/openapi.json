    "/providers/{id}/availability": {
      "get": {
        "description": "Every start time a client could request, on a 15-minute grid.",
        "operationId": "ProvidersController_availability",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "serviceId",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "Local date at the provider's time zone (YYYY-MM-DD)",
            "schema": {
              "example": "2026-11-20",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {

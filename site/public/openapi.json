      }
    },
    "/courts/{id}/availability": {
      "get": {
        "description": "Every slot of the local date, with whether it can still be booked.",
        "operationId": "CourtsController_availability",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "Local date at the venue (YYYY-MM-DD)",
            "schema": {
              "example": "2026-11-20",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every slot of the day and whether it can still be booked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SlotResponse"
                  }
                }
              }
            }
          }
        },
        "summary": "Availability for a day",
        "tags": [
          "courts"
        ]
      }
    },
    "/bookings": {
      "post": {
        "description": "Held for 15 minutes until paid. Overlapping requests get 409, even when they arrive at the same instant.",
        "operationId": "BookingsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booked; holds the slot until paid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Outside opening hours, off the slot grid, or in the past"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "That time is already booked"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Book a slot",
        "tags": [
          "bookings"
        ]
      }
    },
    "/bookings/me": {

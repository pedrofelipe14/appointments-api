          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "My appointments",
        "tags": [
          "appointments"
        ]
      }
    },
    "/appointments/inbox": {
      "get": {
        "description": "The provider's agenda. Filter with ?status=pending to see what needs an answer.",
        "operationId": "AppointmentsController_inbox",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Only appointments in this status",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "rejected",
                "cancelled",
                "expired"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppointmentResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "403": {
            "description": "Requires role: provider or admin"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Requests and appointments to handle",
        "tags": [
          "appointments"
        ]
      }
    },
    "/appointments/{id}/confirm": {
      "post": {
        "description": "Only the provider. The client gets a notification.",
        "operationId": "AppointmentsController_confirm",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "403": {
            "description": "Not this provider's request\n\nRequires role: provider or admin"
          },
          "409": {
            "description": "Already answered, cancelled or expired"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Confirm a request",
        "tags": [
          "appointments"
        ]
      }
    },
    "/appointments/{id}/reject": {
      "post": {
        "description": "Only the provider, with a reason the client will see. The time frees up.",
        "operationId": "AppointmentsController_reject",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"

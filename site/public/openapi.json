  "info": {
    "title": "Appointments API",
    "description": "Clients ask for \"this week, in the afternoon\"; the API picks the first free time and holds it until the provider confirms. Two requests never get the same time.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateProviderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Clases de guitarra con Lucía"
          },
          "about": {
            "type": "string",
            "example": "Guitarra eléctrica y acústica, todos los niveles."
          },
          "timezone": {
            "type": "string",
            "example": "America/Argentina/Buenos_Aires",
            "default": "America/Argentina/Buenos_Aires"
          },
          "confirmWithinHours": {
            "type": "number",
            "example": 24,
            "default": 24,
            "description": "Hours to confirm a request before it expires (1-168)"
          }
        },
        "required": [
          "name"
        ]
      },
      "ServiceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "number"
          },
          "priceCents": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "providerId",
          "name",
          "description",
          "durationMinutes",
          "priceCents"
        ]
      },
      "WorkingRangeResponse": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "number"
          },
          "startsAt": {
            "type": "string",
            "example": "10:00"
          },
          "endsAt": {
            "type": "string",
            "example": "13:00"
          }
        },
        "required": [
          "weekday",
          "startsAt",
          "endsAt"
        ]
      },
      "ProviderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "about": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "confirmWithinHours": {
            "type": "number"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceResponse"
            }
          },
          "workingHours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkingRangeResponse"
            }
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "about",
          "timezone",
          "confirmWithinHours",
          "services",
          "workingHours"
        ]
      },
      "WorkingRangeDto": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "number",
            "example": 1,
            "description": "ISO weekday: 1 = Monday ... 7 = Sunday"
          },
          "startsAt": {
            "type": "string",
            "example": "10:00"
          },
          "endsAt": {
            "type": "string",
            "example": "13:00"
          }
        },
        "required": [
          "weekday",
          "startsAt",
          "endsAt"
        ]
      },
      "WorkingHoursDto": {
        "type": "object",
        "properties": {
          "hours": {
            "description": "Replaces the whole weekly schedule",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkingRangeDto"
            }
          }
        },
        "required": [
          "hours"
        ]
      },
      "CreateServiceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Clase individual"
          },
          "description": {
            "type": "string",
            "example": "Una hora, en el estudio o por videollamada."
          },
          "durationMinutes": {
            "type": "number",
            "example": 60,
            "description": "Minutes, a multiple of 15 between 15 and 480"
          },
          "priceCents": {
            "type": "number",
            "example": 1500000,
            "description": "Price in cents (ARS 15,000.00)"
          }
        },
        "required": [
          "name",
          "durationMinutes",
          "priceCents"
        ]
      },
      "SlotResponse": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          }
        },
        "required": [
          "startsAt",
          "endsAt"
        ]
      },
      "RequestAppointmentDto": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "example": "2026-11-20T16:00:00-03:00",
            "description": "A specific start time. Leave it out to let the API pick the first free time."
          },
          "from": {
            "type": "string",
            "example": "2026-11-16",
            "description": "Search from this local date (default: today)"
          },
          "to": {
            "type": "string",
            "example": "2026-11-22",
            "description": "Search until this local date, inclusive (default: two weeks from \"from\")"
          },
          "timeOfDay": {
            "type": "string",
            "enum": [
              "any",
              "morning",
              "afternoon",
              "evening"
            ],
            "default": "any",
            "description": "morning 6-12 · afternoon 12-19 · evening 19-24 (provider time)"
          },
          "note": {
            "type": "string",
            "example": "Primera clase, nivel principiante"
          }
        },
        "required": [
          "serviceId"
        ]
      },
      "AppointmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "providerName": {
            "type": "string"
          },
          "serviceId": {
            "type": "string"
          },
          "serviceName": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "rejected",
              "cancelled",
              "expired"
            ]
          },
          "priceCents": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "rejectionReason": {
            "type": "object",
            "nullable": true
          },
          "respondBy": {
            "type": "string",
            "description": "If the provider has not answered by then, the request expires"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "providerId",
          "providerName",
          "serviceId",
          "serviceName",
          "clientId",
          "clientName",
          "startsAt",
          "endsAt",
          "status",
          "priceCents",
          "note",
          "rejectionReason",
          "respondBy",
          "createdAt"
        ]
      },
      "RejectDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Ese día no estoy, ¿probás el jueves?"
          }
        },
        "required": [
          "reason"
        ]
      },
      "NotificationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "requested",
              "confirmed",
              "rejected",
              "expired",
              "cancelled"
            ]
          },
          "appointmentId": {
            "type": "string"
          },
          "serviceName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "appointmentId",
          "serviceName",
          "startsAt",
          "read",
          "createdAt"
        ]
      },
      "NotificationsResponse": {
        "type": "object",
        "properties": {
          "unread": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationResponse"
            }
          }
        },
        "required": [
          "unread",
          "items"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "lio@example.com"
          },
          "name": {
            "type": "string",
            "example": "Lio"
          },
          "password": {
            "type": "string",
            "example": "a-long-password",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "client",
              "provider"
            ],
            "default": "client",
            "description": "Providers publish services and confirm requests. Admins are never self-registered."
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "client",
              "provider",
              "admin"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "lio@example.com"
          },
          "password": {
            "type": "string",
            "example": "a-long-password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 3600
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      }
    }
  }
}
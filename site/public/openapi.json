          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Returns a JWT valid for one hour. Send it as `Authorization: Bearer <token>`.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "summary": "Log in",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The current user",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Court Booking API",
    "description": "Book football courts: venues, courts, live availability and bookings that can never overlap.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateVenueDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Complejo La Bombonerita"
          },
          "address": {
            "type": "string",
            "example": "Av. Siempre Viva 742, Mar del Plata"
          },
          "timezone": {
            "type": "string",
            "example": "America/Argentina/Buenos_Aires",
            "default": "America/Argentina/Buenos_Aires"
          }
        },
        "required": [
          "name",
          "address"
        ]
      },
      "VenueResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "timezone",
          "ownerId"
        ]
      },
      "CreateCourtDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Cancha 1"
          },
          "sport": {
            "type": "string",
            "enum": [
              "futbol5",
              "futbol7",
              "futbol11"
            ]
          },
          "pricePerHourCents": {
            "type": "number",
            "example": 4500000,
            "description": "Price per hour in cents (ARS 45,000.00)"
          },
          "opensAt": {
            "type": "string",
            "example": "09:00",
            "description": "Local opening time (HH:MM)"
          },
          "closesAt": {
            "type": "string",
            "example": "23:00",
            "description": "Local closing time (HH:MM), after opensAt"
          },
          "slotMinutes": {
            "type": "number",
            "enum": [
              30,
              60,
              90,
              120
            ],
            "default": 60
          }
        },
        "required": [
          "name",
          "sport",
          "pricePerHourCents",
          "opensAt",
          "closesAt"
        ]
      },
      "CourtResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "venueId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sport": {
            "type": "string",
            "enum": [
              "futbol5",
              "futbol7",
              "futbol11"
            ]
          },
          "pricePerHourCents": {
            "type": "number"
          },
          "opensAt": {
            "type": "string",
            "example": "09:00"
          },
          "closesAt": {
            "type": "string",
            "example": "23:00"
          },
          "slotMinutes": {
            "type": "number"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "venueId",
          "name",
          "sport",
          "pricePerHourCents",
          "opensAt",
          "closesAt",
          "slotMinutes",
          "timezone"
        ]
      },
      "SlotResponse": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "available"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "example": "2026-11-20T20:00:00-03:00",
            "description": "ISO 8601 with offset; must fall on a slot boundary"
          },
          "durationMinutes": {
            "type": "number",
            "example": 60,
            "description": "A multiple of the court slot length, up to 180"
          }
        },
        "required": [
          "courtId",
          "startsAt",
          "durationMinutes"
        ]
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "courtId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_payment",
              "confirmed",
              "cancelled",
              "expired"
            ]
          },
          "priceCents": {
            "type": "number",
            "description": "Total price in cents"
          },
          "expiresAt": {
            "type": "object",
            "nullable": true,
            "description": "An unpaid booking stops holding the slot after this"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "courtId",
          "userId",
          "startsAt",
          "endsAt",
          "status",
          "priceCents",
          "expiresAt",
          "createdAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "lio@example.com"
          },
          "name": {
            "type": "string",
            "example": "Lio"
          },
          "password": {
            "type": "string",
            "example": "a-long-password",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "player",
              "owner"
            ],
            "default": "player",
            "description": "Owners can list venues and courts. Admins are never self-registered."
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "player",
              "owner",
              "admin"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "lio@example.com"
          },
          "password": {
            "type": "string",
            "example": "a-long-password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 3600
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      }
    }
  }
}